{
  "$schema": "./awg31-capability.schema.json",
  "schema_version": 1,
  "contract_id": "pokrov.awg31.endpoint.v1",
  "status": "lab_disabled_by_default",
  "public_runtime_advertised": false,
  "owner": {
    "repository": "Kiwunaka/POKROV-core",
    "layer": "engine/sing-box"
  },
  "engine": {
    "type": "awg",
    "build_tag": "with_awg",
    "android_release_build": true,
    "windows_release_build": true
  },
  "dependency": {
    "module": "github.com/amnezia-vpn/amneziawg-go/v3",
    "version": "v3.1.20260814",
    "source_tag": "v3.1.20260814",
    "source_commit": "1b86b2ae0e493e7ea93f8c1a0f0cb6735b1551f1",
    "module_sum": "h1:l2AhBD+sFycU8Im81n/bZORMxW7fWtlZJEuJ4Hh0+z0=",
    "license": "MIT",
    "notice": "third_party/licenses/amneziawg-go-MIT.txt"
  },
  "supported_platforms": [
    "android",
    "windows"
  ],
  "compatibility": {
    "awg2_contract_id": "pokrov.awg2.endpoint.v1",
    "wire_compatible_with_awg2": false,
    "separate_managed_profile_required": true
  },
  "typed_endpoint": {
    "type": "awg",
    "explicit_contract_id_required": true,
    "use_integrated_tun": false,
    "peer_count": 1,
    "key_encoding": "base64",
    "key_bytes": 32,
    "address_prefix_count": {
      "minimum": 1,
      "maximum": 2
    },
    "peer_address_kind": "ip_literal",
    "allowed_mtu": [
      1280,
      1400,
      1408
    ],
    "maximum_junk_packet_count": 128,
    "maximum_junk_packet_size": 1279,
    "maximum_padding_size": 65535,
    "minimum_header_protection_padding": 12,
    "maximum_instruction_packet_bytes": 512,
    "maximum_content_padding_addition": 512,
    "maximum_persistent_keepalive_seconds": 600,
    "required_awg31_fields": [
      "contract_id",
      "jc",
      "jmin",
      "jmax",
      "s1",
      "s2",
      "s3",
      "s4",
      "h1",
      "h2",
      "h3",
      "h4",
      "header_protection_key"
    ],
    "optional_awg31_fields": [
      "i1",
      "i2",
      "i3",
      "i4",
      "i5",
      "content_padding_addition",
      "rekey_after_time",
      "rekey_timeout",
      "reject_after_time",
      "keepalive_timeout",
      "max_handshake_attempts",
      "random_trailers",
      "persistent_keepalive_interval_range"
    ]
  },
  "fixture_policy": {
    "synthetic_only": true,
    "documentation_address_ranges": [
      "192.0.2.0/24",
      "2001:db8::/32"
    ],
    "real_keys_endpoints_or_provider_payloads": false
  },
  "telemetry": {
    "allowed_dimensions": [
      "transport_family",
      "config_generation",
      "endpoint_category",
      "asn_category",
      "app_version",
      "core_version",
      "network_type",
      "outcome",
      "error_code"
    ],
    "forbidden_dimensions": [
      "private_key",
      "preshared_key",
      "public_key",
      "header_protection_key",
      "instruction_chain",
      "raw_endpoint",
      "raw_config",
      "account_identifier",
      "device_identifier"
    ]
  },
  "evidence_ceiling": {
    "source_and_synthetic_tests": "VERIFIED_LOCAL",
    "exact_android_aar": "MANUAL_OWNER_TEST",
    "exact_windows_dll": "MANUAL_OWNER_TEST",
    "ldplayer_runtime": "BLOCKED_BY_ACCESS",
    "owned_server_interop": "BLOCKED_BY_ACCESS",
    "physical_device": "MANUAL_OWNER_TEST",
    "mobile_origin": "MANUAL_OWNER_TEST"
  }
}
