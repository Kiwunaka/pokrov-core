{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokrov.space/contracts/core/awg31-capability.schema.json",
  "title": "POKROV Core AWG 3.1 lab capability contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "status",
    "public_runtime_advertised",
    "owner",
    "engine",
    "dependency",
    "supported_platforms",
    "compatibility",
    "typed_endpoint",
    "fixture_policy",
    "telemetry",
    "evidence_ceiling"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "contract_id": { "const": "pokrov.awg31.endpoint.v1" },
    "status": { "const": "lab_disabled_by_default" },
    "public_runtime_advertised": { "const": false },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "layer"],
      "properties": {
        "repository": { "const": "Kiwunaka/POKROV-core" },
        "layer": { "const": "engine/sing-box" }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "build_tag", "android_release_build", "windows_release_build"],
      "properties": {
        "type": { "const": "awg" },
        "build_tag": { "const": "with_awg" },
        "android_release_build": { "const": true },
        "windows_release_build": { "const": true }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "version", "source_tag", "source_commit", "module_sum", "license", "notice"],
      "properties": {
        "module": { "const": "github.com/amnezia-vpn/amneziawg-go/v3" },
        "version": { "const": "v3.1.20260814" },
        "source_tag": { "const": "v3.1.20260814" },
        "source_commit": { "const": "1b86b2ae0e493e7ea93f8c1a0f0cb6735b1551f1" },
        "module_sum": { "const": "h1:l2AhBD+sFycU8Im81n/bZORMxW7fWtlZJEuJ4Hh0+z0=" },
        "license": { "const": "MIT" },
        "notice": { "type": "string", "minLength": 1 }
      }
    },
    "supported_platforms": {
      "type": "array",
      "prefixItems": [{ "const": "android" }, { "const": "windows" }],
      "items": false
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["awg2_contract_id", "wire_compatible_with_awg2", "separate_managed_profile_required"],
      "properties": {
        "awg2_contract_id": { "const": "pokrov.awg2.endpoint.v1" },
        "wire_compatible_with_awg2": { "const": false },
        "separate_managed_profile_required": { "const": true }
      }
    },
    "typed_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "explicit_contract_id_required",
        "use_integrated_tun",
        "peer_count",
        "key_encoding",
        "key_bytes",
        "address_prefix_count",
        "peer_address_kind",
        "allowed_mtu",
        "maximum_junk_packet_count",
        "maximum_junk_packet_size",
        "maximum_padding_size",
        "minimum_header_protection_padding",
        "maximum_instruction_packet_bytes",
        "maximum_content_padding_addition",
        "maximum_persistent_keepalive_seconds",
        "required_awg31_fields",
        "optional_awg31_fields"
      ],
      "properties": {
        "type": { "const": "awg" },
        "explicit_contract_id_required": { "const": true },
        "use_integrated_tun": { "const": false },
        "peer_count": { "const": 1 },
        "key_encoding": { "const": "base64" },
        "key_bytes": { "const": 32 },
        "address_prefix_count": { "type": "object" },
        "peer_address_kind": { "const": "ip_literal" },
        "allowed_mtu": {
          "type": "array",
          "prefixItems": [{ "const": 1280 }, { "const": 1400 }, { "const": 1408 }],
          "items": false
        },
        "maximum_junk_packet_count": { "const": 128 },
        "maximum_junk_packet_size": { "const": 1279 },
        "maximum_padding_size": { "const": 65535 },
        "minimum_header_protection_padding": { "const": 12 },
        "maximum_instruction_packet_bytes": { "const": 512 },
        "maximum_content_padding_addition": { "const": 512 },
        "maximum_persistent_keepalive_seconds": { "const": 600 },
        "required_awg31_fields": { "type": "array", "minItems": 13, "uniqueItems": true, "items": { "type": "string" } },
        "optional_awg31_fields": { "type": "array", "minItems": 13, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "fixture_policy": { "type": "object" },
    "telemetry": { "type": "object" },
    "evidence_ceiling": { "type": "object" }
  }
}
