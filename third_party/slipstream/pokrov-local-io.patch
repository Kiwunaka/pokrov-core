+    pub(crate) fn spawn_authenticated(
+        &self,
+        listener: TokioTcpListener,
+        command_tx: mpsc::UnboundedSender<Command>,
+        auth: Arc<LocalAuth>,
+    ) {
+        let limiter = Arc::clone(&self.limiter);
+        tokio::spawn(async move {
+            // Unauthenticated peers cannot consume remote QUIC stream credit.
+            // Bound both idle handshakes and their number on the shared loopback.
+            let pending = Arc::new(tokio::sync::Semaphore::new(32));
+            loop {
+                let Ok(permit) = Arc::clone(&pending).acquire_owned().await else {
+                    break;
+                };
+                let (mut stream, _) = match listener.accept().await {
+                    Ok(accepted) => accepted,
+                    Err(_) => {
+                        sleep(Duration::from_millis(50)).await;
+                        continue;
+                    }
+                };
+                let auth = Arc::clone(&auth);
+                let limiter = Arc::clone(&limiter);
+                let command_tx = command_tx.clone();
+                tokio::spawn(async move {
+                    if !matches!(
+                        tokio::time::timeout(
+                            Duration::from_secs(5),
+                            auth.authenticate(&mut stream)
+                        )
+                        .await,
+                        Ok(Ok(()))
+                    ) {
+                        return;
+                    }
+                    drop(permit);
+                    let reservation = limiter.reserve().await;
+                    if reservation.is_fresh() {
+                        let _ = command_tx.send(Command::NewStream {
+                            stream,
+                            reservation,
+                        });
+                    }
+                });
+            }
+        });
+    }
